{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Minecraft: Build and test",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Dev.ps1",
        "Build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$javac"
      ]
    },
    {
      "label": "Minecraft: Test and coverage",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Dev.ps1",
        "Test"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$javac"
      ]
    },
    {
      "label": "Minecraft: Run local Paper",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Lab.ps1",
        "run"
      ],
      "problemMatcher": [
        "$javac"
      ],
      "presentation": {
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Minecraft: Start debug server",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Lab.ps1",
        "run",
        "-DebugServer"
      ],
      "isBackground": true,
      "problemMatcher": {
        "base": "$javac",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting.*",
          "endsPattern": "^MCDEV_READY.*"
        }
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Minecraft: Real server smoke test",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Lab.ps1",
        "smoke"
      ],
      "problemMatcher": []
    },
    {
      "label": "Minecraft: Check for upgrades",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Dev.ps1",
        "Updates"
      ],
      "problemMatcher": []
    },
    {
      "label": "Minecraft: Play (build + start server)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Lab.ps1",
        "play"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Minecraft: Restart after edits",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Lab.ps1",
        "restart"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Minecraft: Stop server",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Lab.ps1",
        "stop"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Minecraft: Server command",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Lab.ps1",
        "console",
        "-Command",
        "${input:consoleCommand}"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Minecraft: Server logs",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Lab.ps1",
        "logs"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Minecraft: Play another plugin or version",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Lab.ps1",
        "play",
        "-Version",
        "${input:minecraftVersion}",
        "-Profile",
        "external",
        "-PluginPath",
        "${input:pluginPath}"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Minecraft: Test another plugin or version",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Lab.ps1",
        "smoke",
        "-Version",
        "${input:minecraftVersion}",
        "-PluginPath",
        "${input:pluginPath}"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Minecraft: Stop another version",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Lab.ps1",
        "stop",
        "-Version",
        "${input:minecraftVersion}",
        "-Profile",
        "external"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Minecraft: Create a new plugin project",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Lab.ps1",
        "new",
        "-Name",
        "${input:newPluginName}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Symphony: check",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Symphony.ps1",
        "check"
      ],
      "problemMatcher": [],
      "presentation": {
        "focus": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "Symphony: start",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Symphony.ps1",
        "start"
      ],
      "problemMatcher": [],
      "presentation": {
        "focus": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "Symphony: stop",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Symphony.ps1",
        "stop"
      ],
      "problemMatcher": [],
      "presentation": {
        "focus": true,
        "panel": "dedicated"
      }
    },
    {
      "label": "Symphony: set-token",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Symphony.ps1",
        "set-token"
      ],
      "problemMatcher": [],
      "presentation": {
        "focus": true,
        "panel": "dedicated"
      }
    }
  ],
  "inputs": [
    {
      "description": "Server command, without the leading slash",
      "type": "promptString",
      "default": "list",
      "id": "consoleCommand"
    },
    {
      "description": "Minecraft version (e.g. 1.21.11, 26.1.2, 26.2, or latest)",
      "type": "promptString",
      "default": "26.2",
      "id": "minecraftVersion"
    },
    {
      "description": "Plugin JAR or folder path; enter project for this workspace plugin",
      "type": "promptString",
      "default": "project",
      "id": "pluginPath"
    },
    {
      "id": "newPluginName",
      "type": "promptString",
      "description": "Plugin name, starting with a capital letter (e.g. SkyTools)",
      "default": "MyPlugin"
    }
  ]
}